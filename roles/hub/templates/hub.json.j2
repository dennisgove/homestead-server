{#- The Hub's settings. Generated by Ansible (roles/hub); don't edit here. -#}
{%- set pub = [] -%}
{%- for a in homestead_apps -%}
{%- set health = a.health | default('/') -%}
{%- set _ = pub.append({
  'id': a.id, 'title': a.title, 'icon': a.icon | default(''), 'hint': a.hint | default(''),
  'section': a.section | default('hidden'), 'access': a.access | default('public'),
  'scheme': a.scheme | default('http'), 'port': a.port | default(none), 'path': a.path | default('/'),
  'health': ('http://127.0.0.1:' ~ a.backend ~ health) if (a.backend is defined and health) else '',
  'power': a.power | default(''), 'library': a.library | default(false)}) -%}
{%- endfor -%}
{{ {
  'paths': {
    'core': core_dir, 'library': library_mount, 'state': state_dir,
    'status': state_dir ~ '/status', 'hub_state': state_dir ~ '/hub',
    'docs': core_dir ~ '/docs', 'zim_core': core_dir ~ '/zim', 'zim_library': library_mount ~ '/zim',
    'books': library_mount ~ '/books/calibre', 'books_incoming': library_mount ~ '/books/incoming',
    'maps': core_dir ~ '/maps', 'video': library_mount ~ '/video',
    'catalog_base': hub_dir ~ '/catalog.yaml', 'catalog_local': state_dir ~ '/hub/catalog.local.yaml',
  },
  'site': {'hostname': homestead_hostname, 'lan_name': lan_name, 'ssid': hotspot_ssid,
           'region_state': region_state, 'timezone': timezone},
  'apps': pub | selectattr('port') | list + (pub | rejectattr('port') | list),
  'kiwix': {
    'container': 'homestead-kiwix', 'core_app': 'core-library',
    'search_url': 'http://127.0.0.1:' ~ apps_by_id['library'].backend,
    'public_url': 'http://' ~ lan_name ~ ':' ~ apps_by_id['library'].port,
    'core_search_url': 'http://127.0.0.1:' ~ apps_by_id['core-library'].backend,
    'core_public_url': 'http://' ~ lan_name ~ ':' ~ apps_by_id['core-library'].port,
  },
  'ai': {'ollama': 'http://127.0.0.1:' ~ ollama_port, 'fast_model': ai_models.fast, 'keyword_timeout': 15},
  'power': {'eco': power_eco_soc, 'shutdown': power_shutdown_soc},
  'content_tier': content_tier,
  'kolibri_container': 'homestead-kolibri',
  'admin_header': hub_admin_header,
} | to_nice_json }}
