#!/usr/bin/env bash
# Called by udev when the LIBRARY drive appears (and safe to run by hand):
# mount it and bring the search index up to date. (The website reads the drive directly
# and notices it on its own.)
set -euo pipefail
. /etc/homestead/storage.conf

mountpoint -q "$LIBRARY_MOUNT" || mount "$LIBRARY_MOUNT"
systemctl start --no-block homestead-index.service
logger -t homestead "LIBRARY drive online"
