{
  "tasks": {
    "TASK_MODEL": "{{ ai_models.fast }}",
    "ENABLE_TITLE_GENERATION": true,
    "ENABLE_RETRIEVAL_QUERY_GENERATION": true,
    "ENABLE_FOLLOW_UP_GENERATION": false,
    "ENABLE_TAGS_GENERATION": false,
    "ENABLE_SEARCH_QUERY_GENERATION": false,
    "ENABLE_AUTOCOMPLETE_GENERATION": false
  },
  "models": [
{% for p in ai_personas %}
    { "id": "{{ p.name }}:latest", "name": {{ p.title | to_json }}, "description": {{ p.description | to_json }}, "vision": false, "knowledge": {{ p.knowledge | to_json }} }{{ "," }}
{% endfor %}
    { "id": "{{ ai_models.vision }}", "name": "Photo helper (what plant/bug/label is this?)", "description": "Small model that can look at pictures.", "vision": true, "knowledge": false }
  ]
}
