}
:{{ public_ports.pdf_tools }} {
	reverse_proxy 127.0.0.1:{{ ports.stirling_pdf }}
}
:{{ public_ports.it_tools }} {
	reverse_proxy 127.0.0.1:{{ ports.it_tools }}
