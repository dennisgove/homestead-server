}
:{{ public_ports.ai }} {
	reverse_proxy 127.0.0.1:{{ ports.open_webui }}
}
:{{ public_ports.pantry }} {
	reverse_proxy 127.0.0.1:{{ ports.grocy }}
}
:{{ public_ports.recipes }} {
	reverse_proxy 127.0.0.1:{{ ports.mealie }}
}
:{{ public_ports.notes }} {
	reverse_proxy 127.0.0.1:{{ ports.flatnotes }}
}
:{{ public_ports.data_tools }} {
