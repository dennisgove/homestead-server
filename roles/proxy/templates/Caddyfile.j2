# Homestead public entry points. Generated by Ansible from the app registry
# (group_vars/all/apps.yml); don't edit here. Backends are firewalled; everything
# people use goes through these ports. Port-based, not hostname-based, so it
# works on the hotspot, a home LAN, or by IP.
{
	auto_https off
	admin localhost:2019
	# Certificates for the HTTPS ports come from Caddy's own local CA.
	local_certs
	pki {
		ca local {
			name "Homestead Local CA"
		}
	}
	# Caddy can't add its CA to the OS trust store as the caddy user; don't try.
	# (Only takes effect alongside the pki block above.)
	skip_install_trust
}

(admin_auth) {
	basicauth {
		{{ admin_user }} {{ admin_basic_auth_hash }}
	}
}
# On-demand certificates for whatever name the browser used (homestead.local,
# library.lan, an IP). Only Caddy's internal CA, on a LAN: nothing to abuse.
(tls_local) {
	tls {
		on_demand
	}
}

# --- The Hub: the website (also the captive-portal page). Nothing on it asks for a login;
# the Library manager is only on the admin port below.
:80 {
	@probe host connectivitycheck.gstatic.com clients3.google.com captive.apple.com www.apple.com www.msftconnecttest.com detectportal.firefox.com nmcheck.gnome.org
	redir @probe http://{{ lan_name }}/ 302

	# Nobody gets to claim admin by sending the header themselves.
	request_header -X-Homestead-Admin

	handle_path /docs/* {
		root * {{ core_dir }}/docs
		file_server browse
	}
	handle_path /share/* {
		root * {{ core_dir }}/share
		file_server browse
	}
	# Video files for the Hub's Videos page (no login; range requests for seeking).
	handle_path /videos/files/* {
		root * {{ library_mount }}/video
		file_server browse
	}
	# Map tiles, fonts and icons: static files with range requests (PMTiles).
	handle_path /maps/data/* {
		root * {{ core_dir }}/maps
		file_server
	}
	@admin path /library /library/* /api/admin/*
	handle @admin {
		error "Not here" 404
	}
	handle {
		reverse_proxy 127.0.0.1:{{ hub_port }}
	}
	encode gzip
}

# --- The Library manager (admin password). Not linked from the website.
:{{ hub_admin_port }} {
	request_header -X-Homestead-Admin
	import admin_auth
	redir / /library 302
	reverse_proxy 127.0.0.1:{{ hub_port }} {
		header_up X-Homestead-Admin {{ hub_admin_header }}
	}
	encode gzip
}

{% for a in homestead_apps if a.port is defined and a.port != 80 and a.backend is defined %}
{% set https = a.scheme | default('http') == 'https' %}
{% set backend_url = '127.0.0.1:' ~ a.backend %}
# {{ a.title }} ({{ a.id }}, {{ a.access }})
{{ 'https://' if https else '' }}:{{ a.port }} {
{% if a.access == 'local' %}
	bind 127.0.0.1
{% endif %}
{% if https %}
	import tls_local
{% endif %}
{% if a.access == 'admin' %}
	import admin_auth
	reverse_proxy {{ backend_url }}
{% elif a.admin_paths is defined %}
	@adminpaths path {{ a.admin_paths | join(' ') }}
	handle @adminpaths {
		import admin_auth
		reverse_proxy {{ backend_url }}
	}
	handle {
		reverse_proxy {{ backend_url }}
	}
{% else %}
	reverse_proxy {{ backend_url }}
{% endif %}
}
{% for x in a.extra_ports | default([]) %}
:{{ x.port }} {
	reverse_proxy 127.0.0.1:{{ x.backend }}
}
{% endfor %}

{% endfor %}
