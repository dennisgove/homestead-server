# Vaultwarden ({{ ports.vaultwarden }}) and MeshCore Web ({{ ports.meshcore_web }}) aren't here: they
# need HTTPS (WebCrypto / Web Serial), serve it themselves, and the firewall
# lets them through directly.

# --- Admin only (password) -------------------------------------------------
:{{ public_ports.admin_nomad }} {
	import admin_auth
	reverse_proxy 127.0.0.1:{{ ports.nomad }}
}
:{{ public_ports.admin_pat }} {
	import admin_auth
	reverse_proxy 127.0.0.1:{{ ports.pat }}
}
:{{ public_ports.admin_paperless }} {
	import admin_auth
	reverse_proxy 127.0.0.1:{{ ports.paperless }}
}
:{{ public_ports.admin_logs }} {
	import admin_auth
	reverse_proxy 127.0.0.1:{{ ports.dozzle }}
}
:{{ public_ports.admin_files }} {
	import admin_auth
	reverse_proxy 127.0.0.1:{{ ports.filebrowser }}
}
