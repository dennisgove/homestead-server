#!/usr/sbin/nft -f
# Homestead firewall. Generated by Ansible (roles/homestead). Its own table only, so Docker's
# rules are left alone.
table inet homestead {}
delete table inet homestead

table inet homestead {
	# Everything behind Caddy: the website and manager, the tools, the AI engine, Caddy's admin.
	set inside {
		type inet_service; flags interval
		elements = { 2019, 8080-8999, 9999, 11434-11435 }
	}

	# Before Docker's port forwarding, so container ports are covered too.
	chain prerouting_guard {
		type filter hook prerouting priority -150; policy accept;
		iifname "lo" accept
		iifname "docker0" accept
		iifname "br-*" accept
		fib daddr type local tcp dport @inside drop
	}

	# The kiosk's guest account uses the website through Caddy like everyone else, and can't
	# reach the library manager (8701) or anything else behind it.
	chain output_guard {
		type filter hook output priority -150; policy accept;
		meta skuid "{{ kiosk_user }}" fib daddr type local tcp dport @inside reject with tcp reset
		meta skuid "{{ kiosk_user }}" ip daddr 172.16.0.0/12 reject
	}

	chain input {
		type filter hook input priority 0; policy drop;
		iifname "lo" accept
		ct state established,related accept
		ct state invalid drop
		iifname "docker0" accept
		iifname "br-*" accept
		meta l4proto { icmp, ipv6-icmp } accept

		tcp dport { 80, 7000-7099 } accept              # the website and the tools (Caddy)
		udp dport { 53, 67, 68 } accept                 # hotspot DHCP and DNS
		tcp dport 53 accept
		udp dport 5353 accept                           # mDNS (homestead.local)
		udp dport 546 accept                            # DHCPv6 client
		iifname "en*" tcp dport 22 accept               # SSH, wired ethernet only
		iifname "eth*" tcp dport 22 accept

		limit rate 5/minute log prefix "homestead-drop: "
	}
}
