# The programs behind the website's Tools page, the AI engine, and the vault's document
# archive. Generated by Ansible (roles/homestead); edit group_vars/all/website.yml instead.
name: homestead
services:
  ollama:
    image: {{ images.ollama }}
    container_name: homestead-ollama
    restart: unless-stopped
    ports: ["127.0.0.1:{{ ollama_port }}:11434"]
    environment:
      OLLAMA_HOST: 0.0.0.0
      OLLAMA_MAX_LOADED_MODELS: "{{ ai_max_loaded_models }}"
      OLLAMA_NUM_PARALLEL: "1"
      OLLAMA_KEEP_ALIVE: "{{ ai_keep_alive }}"
      OLLAMA_CONTEXT_LENGTH: "{{ ai_context }}"
    volumes: ["{{ homestead_data }}/ollama:/root/.ollama"]

  grocy:
    image: {{ images.grocy }}
    container_name: homestead-grocy
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id.pantry.backend }}:80"]
    environment: { PUID: "1000", PGID: "1000", TZ: "{{ timezone }}" }
    volumes: ["{{ homestead_data }}/grocy:/config"]

  flatnotes:
    image: {{ images.flatnotes }}
    container_name: homestead-flatnotes
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id.notes.backend }}:8080"]
    environment: { FLATNOTES_AUTH_TYPE: none, PUID: "1000", PGID: "1000" }
    volumes: ["{{ homestead_data }}/flatnotes:/data"]

  stirling-pdf:
    image: {{ images.stirling_pdf }}
    container_name: homestead-stirling-pdf
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id['pdf-tools'].backend }}:8080"]
    environment: { SECURITY_ENABLELOGIN: "false", LANGS: en_US }
    volumes:
      - "{{ homestead_data }}/stirling-pdf/configs:/configs"
      - "{{ homestead_data }}/stirling-pdf/logs:/logs"

  cyberchef:
    image: {{ images.cyberchef }}
    container_name: homestead-cyberchef
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id['data-tools'].backend }}:80"]

  it-tools:
    image: {{ images.it_tools }}
    container_name: homestead-it-tools
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id['it-tools'].backend }}:80"]

  excalidraw:
    image: {{ images.excalidraw }}
    container_name: homestead-excalidraw
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id.whiteboard.backend }}:80"]

  openwebrx:
    image: {{ images.openwebrx }}
    container_name: homestead-openwebrx
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id.sdr.backend }}:8073"]
    devices: ["/dev/bus/usb:/dev/bus/usb"]
    tmpfs: ["/tmp:mode=1777"]
    environment:
      TZ: "{{ timezone }}"
      OPENWEBRX_ADMIN_USER: "{{ admin_user }}"
      OPENWEBRX_ADMIN_PASSWORD: "{{ openwebrx_admin_password }}"
    volumes:
      - "{{ homestead_data }}/openwebrx/var:/var/lib/openwebrx"
      - "{{ homestead_data }}/openwebrx/etc:/etc/openwebrx"

  meshcore-web:
    image: {{ images.meshcore_web }}
    container_name: homestead-meshcore-web
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id.mesh.backend }}:80"]

  meshtastic-web:
    image: {{ images.meshtastic_web }}
    container_name: homestead-meshtastic-web
    restart: unless-stopped
    ports: ["127.0.0.1:{{ tools_by_id.meshtastic.backend }}:8080"]

  # The family document vault: only runs while the vault is open (homestead-vault open).
  paperless-redis:
    image: {{ images.redis }}
    container_name: homestead-paperless-redis
    profiles: [vault]
    restart: "no"
  paperless:
    image: {{ images.paperless }}
    container_name: homestead-paperless
    profiles: [vault]
    restart: "no"
    depends_on: [paperless-redis]
    ports: ["127.0.0.1:{{ vault_backend }}:8000"]
    environment:
      PAPERLESS_REDIS: redis://paperless-redis:6379
      PAPERLESS_TIME_ZONE: "{{ timezone }}"
      PAPERLESS_OCR_LANGUAGE: eng
      PAPERLESS_URL: "http://{{ lan_name }}:{{ vault_port }}"
      USERMAP_UID: "1000"
      USERMAP_GID: "1000"
    volumes:
      - "{{ vault_mount }}/paperless/data:/usr/src/paperless/data"
      - "{{ vault_mount }}/paperless/media:/usr/src/paperless/media"
      - "{{ vault_mount }}/paperless/consume:/usr/src/paperless/consume"
      - "{{ vault_mount }}/paperless/export:/usr/src/paperless/export"
