# Homestead. Generated by Ansible (roles/homestead); edit group_vars/all/website.yml instead.
#
#   :80          the website, and the library's files (served directly, with byte ranges)
#   :7008-7020   the tools (no login)        :7091 :7092  admin pages (admin password)
# Sites are by port, not by name, so everything works by any name or IP.
{
	auto_https off
	admin localhost:2019
	# The tools that need HTTPS (Web Serial / Bluetooth) use Caddy's own local certificate.
	local_certs
	skip_install_trust
}

(admin) {
	basicauth {
		{{ admin_user }} {{ admin_basic_auth_hash }}
	}
}

(local_tls) {
	tls {
		on_demand
	}
}

:80 {
	# Phones and laptops check for a captive portal on joining the hotspot: send them to the website.
	@probe host connectivitycheck.gstatic.com clients3.google.com captive.apple.com www.apple.com www.msftconnecttest.com detectportal.firefox.com nmcheck.gnome.org
	redir @probe http://{{ lan_name }}/ 302

	handle_path /files/docs/* {
		root * {{ core_dir }}/docs
		file_server
	}
	handle_path /files/maps/* {
		root * {{ core_dir }}/maps
		file_server
	}
	handle_path /files/share/* {
		root * {{ core_dir }}/share
		file_server
	}
	handle_path /files/courses/* {
		root * {{ library_mount }}/courses
		file_server
	}
	handle_path /files/video/* {
		root * {{ library_mount }}/video
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:{{ site_port }} {
			flush_interval -1
		}
	}
	encode gzip
}

{% for t in tools %}
# {{ t.title }}
{{ 'https://' if t.scheme | default('http') == 'https' else '' }}:{{ t.port }} {
{% if t.scheme | default('http') == 'https' %}
	import local_tls
{% endif %}
{% if t.id == 'sdr' %}
	@settings path {{ sdr_admin_paths | join(' ') }}
	handle @settings {
		import admin
		reverse_proxy 127.0.0.1:{{ t.backend }}
	}
	handle {
		reverse_proxy 127.0.0.1:{{ t.backend }}
	}
{% else %}
	reverse_proxy 127.0.0.1:{{ t.backend }}
{% endif %}
}
{% if t.local_port is defined %}
# {{ t.title }} for this computer's own screen (http://localhost counts as secure: no certificate)
:{{ t.local_port }} {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:{{ t.backend }}
}
{% endif %}

{% endfor %}
# Winlink (Pat): admin only
:{{ winlink_port }} {
	import admin
	reverse_proxy 127.0.0.1:{{ winlink_backend }}
}

# The vault's documents (Paperless, while the vault is open): admin only
:{{ vault_port }} {
	import admin
	reverse_proxy 127.0.0.1:{{ vault_backend }}
}
