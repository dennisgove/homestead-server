#!/usr/bin/env python3
"""Write the portal status strip (status/status.json). Run every minute by a timer."""
import json
import os
import subprocess
import time

STATE = "/var/lib/homestead"
OUT = "/srv/portal/status/status.json"


def sh(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def uptime():
    with open("/proc/uptime") as f:
        secs = int(float(f.read().split()[0]))
    d, rem = divmod(secs, 86400)
    h, m = divmod(rem // 60, 60)
    return f"{d}d {h}h" if d else f"{h}h {m}m"


def wifi_clients():
    # Count stations on any interface running in AP mode.
    n, found = 0, False
    for line in sh("iw", "dev").splitlines():
        line = line.strip()
        if line.startswith("Interface "):
            iface = line.split()[1]
        elif line == "type AP":
            found = True
            n += sh("iw", "dev", iface, "station", "dump").count("Station ")
    return n if found else None


def main():
    status = {
        "time": int(time.time()),
        "uptime": uptime(),
        "library": subprocess.run(["mountpoint", "-q", "/srv/library"]).returncode == 0,
        # Still on the temporary internal volume (no external drive added yet)?
        "library_temp": "lv_library" in sh("findmnt", "-no", "SOURCE", "/srv/library"),
        "clients": wifi_clients(),
        "eco": os.path.exists(f"{STATE}/eco"),
        "power": read_json(f"{STATE}/power.json"),
    }
    try:
        last = os.path.getmtime(f"{STATE}/last-backup")
        status["last_backup"] = time.strftime("%b %d", time.localtime(last))
        status["backup_stale"] = time.time() - last > 8 * 86400
    except OSError:
        status["last_backup"] = "never"
        status["backup_stale"] = True

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(status, f)
    os.replace(tmp, OUT)


if __name__ == "__main__":
    main()
