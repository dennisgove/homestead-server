#!/usr/bin/env python3
"""Point NOMAD's links to its apps at their public ports.

NOMAD links each app to its backend port (8090, 8410, ...), which the firewall
blocks. For every installed app listed in /etc/homestead/nomad-links.json, set
NOMAD's custom URL to the app's public port. Only changes what differs, so it's
cheap to run from a timer. Managed by Ansible (roles/nomad).
"""
import json
import sys
import urllib.error
import urllib.request

CONF = "/etc/homestead/nomad-links.json"


def call(url, method="GET", body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def main():
    with open(CONF) as f:
        conf = json.load(f)
    api = conf["api"].rstrip("/")
    try:
        services = call(f"{api}/api/system/services")
    except (urllib.error.URLError, OSError, ValueError) as e:
        sys.exit(f"NOMAD not reachable: {e}")

    for s in services:
        want = conf["links"].get(s.get("service_name"))
        # NOMAD stores the URL normalized, with a trailing slash.
        if not want or (s.get("custom_url") or "").rstrip("/") == want.rstrip("/"):
            continue
        try:
            call(f"{api}/api/system/services/custom-url", "PUT",
                 {"service_name": s["service_name"], "custom_url": want})
            print(f"set {s['service_name']} -> {want}")
        except (urllib.error.URLError, OSError, ValueError) as e:
            print(f"couldn't set {s['service_name']}: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
