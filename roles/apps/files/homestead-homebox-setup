#!/usr/bin/env python3
"""Create the one shared family account in Homebox (the inventory). Homebox has
no way to browse without logging in, so everyone uses this account; its
password is on the printed WiFi sign (sudo cat /etc/homestead/homebox-family).

Once the account exists it writes the marker file, and Ansible then closes
registration so nobody makes a second, separate inventory by mistake.
Prints "changed" when it created the account. Managed by Ansible (roles/apps)."""
import json
import os
import pathlib
import sys
import time
import urllib.error
import urllib.request

URL = os.environ["HOMEBOX_URL"].rstrip("/")
EMAIL = os.environ["HOMEBOX_EMAIL"]
PASSWORD = os.environ["HOMEBOX_PASSWORD"]
MARKER = pathlib.Path(os.environ["HOMEBOX_MARKER"])


def post(path, body):
    r = urllib.request.Request(URL + path, data=json.dumps(body).encode(), method="POST",
                               headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(r, timeout=30) as f:
        return f.status


for _ in range(60):  # wait for Homebox to answer
    try:
        urllib.request.urlopen(URL + "/api/v1/status", timeout=5)
        break
    except OSError:
        time.sleep(2)

try:
    post("/api/v1/users/login", {"username": EMAIL, "password": PASSWORD, "stayLoggedIn": True})
    MARKER.touch()
    print("family account ok")
    sys.exit(0)
except urllib.error.HTTPError:
    pass

try:
    post("/api/v1/users/register", {"name": "Family", "email": EMAIL, "password": PASSWORD})
except urllib.error.HTTPError as e:
    sys.exit(f"Couldn't create the family account in Homebox (HTTP {e.code}: {e.read().decode()[:200]}). "
             f"If registration is closed, remove {MARKER} and re-run bootstrap.sh.")
MARKER.touch()
print("family account created changed")
