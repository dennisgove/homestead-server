#!/usr/bin/env python3
"""Set up Calibre-Web without clicking: point it at the books library (/books),
let anyone browse without logging in, and set the admin login. Calibre-Web keeps
these in its own database (app.db), which it creates on first start.
Prints "changed" when it changed something (and restarts the container).
Managed by Ansible (roles/apps)."""
import hashlib
import os
import secrets
import sqlite3
import subprocess
import sys
import time

DB = os.environ["CALIBREWEB_DB"]
ADMIN = os.environ["CALIBREWEB_ADMIN"]
PASSWORD = os.environ["CALIBREWEB_PASSWORD"]

for _ in range(60):  # first start creates it
    if os.path.exists(DB):
        break
    time.sleep(2)
else:
    sys.exit(f"{DB} never appeared; is homestead-calibreweb running?")


def werkzeug_hash(pw: str) -> str:
    salt = secrets.token_hex(8)
    h = hashlib.pbkdf2_hmac("sha256", pw.encode(), salt.encode(), 600000).hex()
    return f"pbkdf2:sha256:600000${salt}${h}"


def werkzeug_check(stored: str, pw: str) -> bool:
    try:
        method, salt, h = stored.split("$", 2)
        _, algo, rounds = method.split(":")
        return hashlib.pbkdf2_hmac(algo, pw.encode(), salt.encode(), int(rounds)).hex() == h
    except ValueError:
        return False


changed = False
con = sqlite3.connect(DB, timeout=30)
cols = {r[1] for r in con.execute("PRAGMA table_info(settings)")}
want = {"config_calibre_dir": "/books", "config_anonbrowse": 1, "config_check_extensions": 1}
cur = con.execute(f"SELECT {', '.join(k for k in want if k in cols)} FROM settings LIMIT 1").fetchone()
for (k, v), have in zip([(k, v) for k, v in want.items() if k in cols], cur or []):
    if have != v:
        con.execute(f"UPDATE settings SET {k} = ?", (v,))
        changed = True
# The first user is the admin ("admin" / "admin123" on a fresh install).
row = con.execute("SELECT id, name, password FROM user WHERE role & 1 = 1 ORDER BY id LIMIT 1").fetchone()
if row and (row[1] != ADMIN or not werkzeug_check(row[2] or "", PASSWORD)):
    con.execute("UPDATE user SET name = ?, password = ? WHERE id = ?", (ADMIN, werkzeug_hash(PASSWORD), row[0]))
    changed = True
con.commit()
con.close()
if changed:
    subprocess.run(["docker", "restart", "homestead-calibreweb"], check=False, capture_output=True)
    print("changed")
