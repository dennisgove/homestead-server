#!/usr/bin/env python3
"""Make the recipes readable without logging in (Mealie: public group and
household, recipes public by default). Mealie keeps these in its own database.

On a fresh Mealie the admin is changeme@example.com / MyPassword; this sets
that account's password to the generated one (sudo cat /etc/homestead/mealie-admin).
Prints "changed" when it changed something. Managed by Ansible (roles/apps)."""
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

URL = os.environ["MEALIE_URL"].rstrip("/")
EMAIL = "changeme@example.com"
DEFAULT_PW = "MyPassword"
PASSWORD = os.environ["MEALIE_PASSWORD"]


def req(method, path, body=None, token=None, form=False):
    data, headers = None, {}
    if body is not None:
        data = urllib.parse.urlencode(body).encode() if form else json.dumps(body).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded" if form else "application/json"
    if token:
        headers["Authorization"] = f"Bearer {token}"
    r = urllib.request.Request(URL + path, data=data, method=method, headers=headers)
    with urllib.request.urlopen(r, timeout=30) as f:
        raw = f.read()
        return json.loads(raw) if raw else None


def login(pw):
    try:
        return req("POST", "/api/auth/token", {"username": EMAIL, "password": pw}, form=True)["access_token"]
    except urllib.error.HTTPError:
        return None


for _ in range(60):  # wait for Mealie to answer
    try:
        req("GET", "/api/app/about")
        break
    except OSError:
        time.sleep(2)

changed = False
token = login(PASSWORD)
if token is None:
    token = login(DEFAULT_PW)
    if token is None:
        sys.exit("Can't log in to Mealie as its admin (password changed by hand?); recipes stay as they are.")
    req("PUT", "/api/users/password", {"currentPassword": DEFAULT_PW, "newPassword": PASSWORD}, token)
    changed = True

for path, want in (("/api/groups/preferences", {"privateGroup": False}),
                   ("/api/households/preferences", {"privateHousehold": False, "recipePublic": True})):
    cur = req("GET", path, token=token)
    if any(cur.get(k) != v for k, v in want.items()):
        req("PUT", path, {**cur, **want}, token)
        changed = True

slug = req("GET", "/api/groups/self", token=token).get("slug", "home")
print(f"public recipes at /g/{slug}" + (" changed" if changed else ""))
